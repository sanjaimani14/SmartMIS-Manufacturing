# ==============================================================================
# SmartMIS Manufacturing Intelligence - Environment Configuration Template
# Sakthi Hackathon 2.0 | PS-005: Automated Manufacturing MIS & Rejection Generator
# ==============================================================================

# Plant & Corporate Branding
COMPANY=Sakthi Automotive Foundries & Machining Ltd
REJECTION_TARGET=2.5
AMBER_LIMIT=3.75

# Central Database Connection URL
# SQLite default: sqlite:///smartmis.db
# MySQL example: mysql+pymysql://user:password@localhost:3306/smartmis_pms
# SQL Server example: mssql+pyodbc://user:password@server/smartmis_pms?driver=ODBC+Driver+17+for+SQL+Server
PMS_DATABASE_URL=sqlite:///smartmis.db

# Live Shopfloor Mock PMS Endpoint (FastAPI)
PMS_API_URL=http://localhost:8001/api/pms/today

# Anthropic Claude API Key (Optional - SmartMIS automatically falls back to offline rule-based parser)
ANTHROPIC_API_KEY=

# Automated Report SMTP Email Dispatch Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=reports@sakthiauto.com
SMTP_PASS=
ALERT_EMAIL_RECIPIENT=planthead@sakthiauto.com

# Streamlit Server Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
